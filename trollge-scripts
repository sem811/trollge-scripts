local function setState(state, msg)
    if state == "loading" then
        TopBar.BackgroundColor3 = C.GRAY
        StatusPillText.Text = "VERIFYING ACCESS"
        StatusPillText.TextColor3 = C.GRAY
        StatusPillStroke.Color = C.GRAY
        Title.Text = "Checking your key"
        Sub.Text = "Validating with the secure gateway"
        StatusLabel.Text = ""; StatusLabel.TextColor3 = C.GRAY
        ActivateBtn.Active = false
        tw(ActivateBtn, {BackgroundTransparency=0.6, TextTransparency=0.5}, 0.15)

    elseif state == "success" then
        TopBar.BackgroundColor3 = C.GREEN
        StatusPillText.Text = "ACCESS GRANTED"
        StatusPillText.TextColor3 = C.GREEN
        StatusPillStroke.Color = C.GREEN
        Title.Text = "Access unlocked"
        Sub.Text = "Loading " .. GAME_NAME .. "..."
        StatusLabel.Text = msg or "Welcome!"; StatusLabel.TextColor3 = C.GREEN
        toast("Key valid! Loading script...", true)
        tw(GKWrap,      {BackgroundTransparency=1}, 0.2)
        tw(GetKeyBtn,   {BackgroundTransparency=1, TextTransparency=1}, 0.2)
        tw(ActivateWrap,{BackgroundTransparency=1}, 0.2)
        tw(ActivateBtn, {BackgroundTransparency=1, TextTransparency=1}, 0.2)
        tw(InputWrap,   {BackgroundTransparency=1}, 0.2)
        tw(InputField,  {TextTransparency=1}, 0.2)
        task.delay(1.5, function()
            tw(Card, {BackgroundTransparency=1, Position=UDim2.new(0.5,-W/2,0.5,-H/2-20)}, 0.3)
            task.delay(0.35, function() Gui:Destroy() end)
        end)

    elseif state == "error" then
        TopBar.BackgroundColor3 = C.RED
        StatusPillText.Text = "ACCESS LOCKED"
        StatusPillText.TextColor3 = C.RED
        StatusPillStroke.Color = C.RED
        Title.Text = "Access unavailable"
        Sub.Text = msg or "Invalid or expired key"
        local keyProblem = msg and (msg:find("Invalid") or msg:find("expired") or msg:find("another") or msg:find("format"))
        StatusLabel.Text = keyProblem and "Copy the link to obtain a new key" or "Please try again in a moment"
        StatusLabel.TextColor3 = C.RED
        ActivateBtn.Text = "Verify"
        tw(ActivateBtn, {BackgroundTransparency=0, TextTransparency=0}, 0.2)
        refreshActions()
        toast(msg or "Unable to unlock this script.", false)
    end
end

local function validateToken()
    local token = InputField.Text:match("^%s*(.-)%s*$"):upper()
    if token == "" then
        setState("error", "Please enter a key first")
        return
    end
    if not token:match("^KEY%-[A-Z2-9][A-Z2-9][A-Z2-9][A-Z2-9]%-[A-Z2-9][A-Z2-9][A-Z2-9][A-Z2-9]%-[A-Z2-9][A-Z2-9][A-Z2-9][A-Z2-9]%-[A-Z2-9][A-Z2-9][A-Z2-9][A-Z2-9]$") then
        setState("error", "Key format is not valid")
        return
    end
    InputField.Text = token
    setState("loading")
    ActivateBtn.Text = "Checking..."
    task.spawn(function()
        local hwid = tostring(LocalPlayer.UserId)
        local srcUrl = GATEWAY_URL .. "?game_id=" .. urlEncode(GAME_ID)
            .. "&key=" .. urlEncode(token)
            .. "&hwid=" .. urlEncode(hwid)
            .. "&executor=" .. urlEncode(executorName())
        if SESSION_ID ~= "" then srcUrl = srcUrl .. "&session_id=" .. urlEncode(SESSION_ID) end
        if VARIANT_ID ~= "" then srcUrl = srcUrl .. "&variant_id=" .. urlEncode(VARIANT_ID) end

        local ok, code = pcall(function() return httpGet(srcUrl) end)
        local response = code and tostring(code) or ""
        local denied = response:find("%[KeySys%] Access Denied") ~= nil
        if ok and code and not denied then
            if type(loadstring) ~= "function" then
                setState("error", "This executor cannot load scripts")
                return
            end
            getgenv().KEY = token
            setState("success", "Access Granted!")
            task.delay(0.5, function()
                local lok, lerr = pcall(function() loadstring(code)() end)
                if not lok then warn("[Script Error] " .. tostring(lerr)) end
            end)
        else
            local errorMessage = "Could not reach Keyify"
            if ok and response:find("locked to another device", 1, true) then
                errorMessage = "Key is linked to another Roblox account"
            elseif ok and response:find("Invalid or expired token", 1, true) then
                errorMessage = "Invalid or expired key"
            elseif ok and response:find("Target script not registered", 1, true) then
                errorMessage = "Script source is not available yet"
            elseif ok and response:find("Failed to fetch original script", 1, true) then
                errorMessage = "Script source is temporarily unavailable"
            end
            if SESSION_ID ~= "" then
                pcall(function()
                    httpGet(BASE_URL .. "/api/session/fail?session_id=" .. urlEncode(SESSION_ID) .. "&reason=" .. urlEncode(errorMessage))
                end)
            end
            setState("error", errorMessage)
        end
    end)
end

