local function urlEncode(value)
    return tostring(value):gsub("([^%w%-_%.~])", function(char)
        return string.format("%%%02X", string.byte(char))
    end)
end

local function httpGet(url)
    if fRequest then
        local response = fRequest({ Url = url, Method = "GET" })
        if response and response.StatusCode and response.StatusCode >= 200 and response.StatusCode < 300 then
            return response.Body
        end
        if response and tostring(response.Body or ""):find("%[KeySys%] Access Denied") then
            return response.Body
        end
        error("HTTP request failed: " .. tostring(response and response.StatusCode or "no response"))
    end
    return game:HttpGet(url, true)
end

local function executorName()
    local detector = identifyexecutor or getexecutorname
    if detector then
        local ok, name = pcall(detector)
        if ok and name then return tostring(name) end
    end
    return "Unknown"
end

