local function rec()
 if not hookmetamethod or not getnamecallmethod then print("[SEMYON] hookmetamethod unsupported") return end
 print("[SEMYON] REC 10s - press E/Q/R")
 local w=newcclosure or function(f) return f end
 local o
 o=hookmetamethod(game,"__namecall",w(function(self,...)
  local m=getnamecallmethod()
  if m=="FireServer" or m=="InvokeServer" then
   local a={...}
   pcall(function()
    local s=""
    for i=1,math.min(#a,6) do
     local v=a[i]
     if typeof(v)=="Instance" then s=s..v.Name.."("..v.ClassName..")" else s=s..tostring(v) end
     if i<#a then s=s..", " end
    end
    print("[SEMYON CALL] "..m.." | "..self:GetFullName().." | "..s)
   end)
  end
  return o(self,...)
 end))
 task.delay(10,function() print("[SEMYON] REC done - send [SEMYON CALL] lines") end)
end

